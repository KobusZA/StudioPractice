# Copy to .env and fill in. Nothing here has a default that would work in
# production by accident.

# Postgres. The compose file publishes on 5440 so it cannot collide with a
# Postgres already installed on the machine - see the note there. Inside the
# compose network the app talks to the `db` service on 5432 instead, which is
# why docker-compose.yml sets its own DATABASE_URL rather than reading this one.
DATABASE_URL=postgres://studiopractice:studiopractice@localhost:5440/studiopractice

# Silences stack traces, and is the default answer for COOKIE_SECURE below.
NODE_ENV=development

PORT=8080

# Secure flag on the session cookie. Leave unset to follow NODE_ENV; set it
# explicitly when the two disagree, which they do more often than not:
#   1  there is HTTPS in front of this process. Required in a real deployment.
#   0  plain HTTP - a compose stack on a laptop. A Secure cookie over http is
#      dropped by the browser, and sign-in then fails with nothing in any log.
COOKIE_SECURE=0

# Only for developing the client on a different port than the API. Empty in a
# real deployment, where web/ is served from this same origin. An allowlist,
# never "*", because these responses carry a credentialed cookie.
ALLOWED_ORIGINS=

# Set to 1 only when something in front of this process rewrites
# X-Forwarded-For. Exposed directly, the header is client-controlled and would
# turn the sign-in rate limit into a formality.
TRUST_PROXY=0

# Photorealistic Output > 3D "Generate model". The key never leaves this
# process; the planner only sends the current massing snapshot. Empty means
# that button returns 503 rather than calling OpenAI.
OPENAI_API_KEY=
