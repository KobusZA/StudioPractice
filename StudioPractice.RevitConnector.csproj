<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitVersion>2027</RevitVersion>
    <RevitInstallPath>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallPath>
    <RevitAddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="StudioPractice.RevitConnector.addin" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <Target Name="DeployAddin" AfterTargets="Build">
    <MakeDir Directories="$(RevitAddinDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" Retries="8" RetryDelayMilliseconds="500" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\StudioPractice.RevitConnector.addin" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
